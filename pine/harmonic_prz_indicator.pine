// ============================================================================
// Harmonic PRZ Matrix — multi-scale scanner with outcome tracking
// TradingView Pine Script v6
//
// Rewritten after studying @reees' "Harmonic Pattern Detection, Prediction and
// Backtesting System" (MPL-2.0), which finds an order of magnitude more valid
// patterns than earlier revisions of this file did. No code is copied — that
// script is built on the author's own reees/TA, reees/Draw, reees/Pattern and
// reees/Obj_XABCD_Harmonic libraries — but four architectural decisions in it
// are demonstrably right and are adopted here, each of which was a defect in
// the previous version:
//
//   1. MULTI-SCALE PIVOTS. It runs detection at pivot lengths 3..20. Earlier
//      revisions here used a single fixed depth, which is the dominant reason
//      they surfaced a handful of patterns where the reference surfaces ~66 on
//      the same chart. A structure that is invisible at depth 5 is obvious at
//      depth 13. Five scales are scanned here (3/5/8/13/21).
//   2. RELATIVE FIB TOLERANCE. It allows 15% error *relative to the theoretical
//      ratio*. This file previously used ~2% in absolute ratio space — roughly
//      seven times stricter, and the reason most real-world patterns were
//      rejected outright.
//   3. TARGET-DERIVED STOP. Its default stop is a percentage of the distance
//      from entry to Target 1, so reward:risk is fixed by construction (1.33 to
//      T1 at the 75% default). Earlier revisions used the fixed XA-ratio stops
//      from PRD §3.2 and then applied a minimum-R:R gate on top — a combination
//      that caps the Gartley's best possible R:R at 1.55 and therefore made it
//      mathematically unable to ever fire (PRD §7.3.1).
//   4. D IS A CONFIRMED PIVOT. A pattern completes when a new pivot lands in
//      the PRZ, not when an arbitrary bar wicks through it. Simpler, far more
//      robust, and it removes the "armed zone waiting for a candle" machinery
//      that made entries rare.
//
// Also adopted: pattern scoring with a score threshold (rather than binary
// pass/fail on every constraint), and the status taxonomy — trades that never
// entered, timed out, or are still open are EXCLUDED from success rates and
// returns instead of being silently counted as wins or losses.
//
// The corrected §3.2 ratio table from PRD.md is retained, including the fixes
// the original design brief got wrong: BC projections and AB=CD are checked,
// stops carry a real buffer, and Butterfly/Crab invalidation is not set at
// their own PRZ edge.
//
// STATISTICS ARE PATH STATISTICS, NOT A BACKTEST. No commission, no slippage,
// and a bar spanning both stop and target resolves as a loss (pessimistic).
// For numbers to stake money on, use harmonic_prz_scanner.pine (the strategy()
// edition) through TradingView's Strategy Tester — see PRD §11.5.
// ============================================================================

//@version=6
indicator("Harmonic PRZ Matrix", shorttitle = "Harmonic PRZ", overlay = true,
    max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500, max_polylines_count = 100)

// ---------------------------------------------------------------- Inputs ---
gI = "Include"
useBull = input.bool(true,  "Bullish", inline = "d", group = gI)
useBear = input.bool(true,  "Bearish", inline = "d", group = gI)
minScore = input.float(65, "Only patterns scoring above", minval = 0, maxval = 100, group = gI, tooltip = "Score blends leg-retracement accuracy, PRZ level confluence, and how close point D landed to the PRZ. Raise for fewer, cleaner patterns.")

gS = "Detection scales"
sc1 = input.bool(true,  "3",  inline = "s", group = gS)
sc2 = input.bool(true,  "5",  inline = "s", group = gS)
sc3 = input.bool(true,  "8",  inline = "s", group = gS)
sc4 = input.bool(true,  "13", inline = "s", group = gS)
sc5 = input.bool(true,  "21", inline = "s", group = gS, tooltip = "Pivot lengths scanned. A pattern invisible at one scale is often obvious at another — scanning several is the single biggest driver of how many valid patterns are found. Disable the small ones on noisy intraday charts.")

gP = "Patterns"
useGartley = input.bool(true, "Gartley",   inline = "p1", group = gP)
useBat     = input.bool(true, "Bat",       inline = "p1", group = gP)
useBfly    = input.bool(true, "Butterfly", inline = "p1", group = gP)
useCrab    = input.bool(true, "Crab",      inline = "p2", group = gP)
useDeep    = input.bool(true, "Deep Crab", inline = "p2", group = gP)
useCypher  = input.bool(true, "Cypher",    inline = "p2", group = gP)

gR = "Ratios & Targets"
pctErr  = input.float(15.0, "Allowed fib ratio error %", minval = 1.0, maxval = 50.0, step = 1.0, group = gR, tooltip = "Error allowed RELATIVE to each theoretical ratio, e.g. 15% on a 0.618 leg accepts 0.525-0.711. This is the standard convention and is far more permissive than an absolute tolerance of the same number.")
t1Mode  = input.string("0.618 AD", "Target 1", options = ["0.382 AD", "0.5 AD", "0.618 AD", "Point C", "Point A"], group = gR)
t2Mode  = input.string("1.272 AD", "Target 2", options = ["0.618 AD", "1.0 AD (Point A)", "1.272 AD", "1.618 AD", "None"], group = gR, tooltip = "AD ratios above 1.0 extend BEYOND point A. That is what makes a 2:1 reward:risk reachable — a target that only retraces part of the A-to-D move rarely does.")
stopMode = input.string("% of distance to Target 1", "Stop basis", options = ["% of distance to Target 1", "% beyond X or D"], group = gR)
stopPct = input.float(75, "Stop %", minval = 5, step = 5, group = gR, tooltip = "With the default basis, the stop sits this percentage of the entry-to-Target-1 distance on the far side of entry, so reward:risk to T1 is fixed at 100/75 = 1.33 and considerably higher to T2. This is what keeps every pattern tradeable; fixed XA-ratio stops make some patterns mathematically unable to reach a 2:1 target at all.")

gT = "Timing"
confirmBars = input.int(2, "Bars to confirm point D", minval = 1, maxval = 10, group = gT, tooltip = "Bars that must close after the D pivot before the pattern is treated as valid and an entry is recorded. Entry price is the close of that confirming bar.")
tLimitMult  = input.float(3.0, "Pattern time limit (× pattern length)", minval = 0.5, step = 0.5, group = gT, tooltip = "How long a pattern has to reach its targets, measured in multiples of its own X-to-D length. Patterns that expire are marked timed out and excluded from the statistics.")

gV = "Display"
showPoly    = input.bool(true, "Fill pattern shape", inline = "v1", group = gV)
showLabels  = input.bool(true, "Labels", inline = "v1", group = gV)
showLevels  = input.bool(true, "Entry / stop / target lines", inline = "v2", group = gV)
showTable   = input.bool(true, "Statistics table", inline = "v2", group = gV)
maxDraw     = input.int(40, "Max patterns drawn", minval = 5, maxval = 200, group = gV, tooltip = "Only the most recent N patterns are drawn. Statistics still count every pattern found.")
cBull = input.color(color.new(#26A69A, 0), "Bullish", inline = "c", group = gV)
cBear = input.color(color.new(#EF5350, 0), "Bearish", inline = "c", group = gV)
tblPos = input.string("Bottom left", "Table", options = ["Bottom left", "Bottom right", "Top left", "Top right"], group = gV)

// ----------------------------------------------------------------- Types ---
type Pivot
    float price
    int   idx
    bool  isHigh

type ZZ
    Pivot[] pts

type PatDef
    string name
    string sym
    float  bLo
    float  bHi
    float  cLo
    float  cHi
    float  dLo
    float  dHi
    bool   cOnXA      // Cypher: C is measured as an extension of XA, not a retracement of AB
    bool   dOnXC      // Cypher: D is measured on the XC leg, not XA

type Sig
    int    patIdx
    bool   isBull
    float  entry
    float  stop
    float  t1
    float  t2
    int    entryBar
    int    expireBar
    int    status     // 0 open, 1 T1+T2, 2 T1 only then stop, 3 stopped, 4 timed out
    bool   t1Hit
    float  score
    label  lbl

// ------------------------------------------------------------ Persisted ---
var ZZ[]     zzs  = array.new<ZZ>()
var PatDef[] defs = array.new<PatDef>()
var Sig[]    sigs = array.new<Sig>()
var string[] seen = array.new<string>()   // dedup key per (type, dir, X, A, B, C, D)
var int[]    cntFound = array.new<int>()

// -------------------------------------------------------------- Helpers ---
// Relative error against a theoretical ratio window, the reference's convention.
okRatio(float v, float lo, float hi, float e) =>
    v >= lo * (1 - e / 100) and v <= hi * (1 + e / 100)

// 0..1, how well v sits inside its window; 1 = dead centre, 0 = at the error edge.
fitScore(float v, float lo, float hi, float e) =>
    mid = (lo + hi) / 2
    tol = mid * (e / 100)
    tol <= 0 ? 0.0 : math.max(0.0, 1.0 - math.abs(v - mid) / (tol + (hi - lo) / 2))

pushPivot(ZZ z, float price, int idx, bool isHigh) =>
    bool added = false
    n = array.size(z.pts)
    if n == 0
        array.push(z.pts, Pivot.new(price, idx, isHigh))
        added := true
    else
        last = array.get(z.pts, n - 1)
        if last.isHigh == isHigh
            if (isHigh and price > last.price) or (not isHigh and price < last.price)
                array.set(z.pts, n - 1, Pivot.new(price, idx, isHigh))
        else
            array.push(z.pts, Pivot.new(price, idx, isHigh))
            added := true
    if array.size(z.pts) > 40
        array.shift(z.pts)
    added

if barstate.isfirst
    for i = 0 to 4
        array.push(zzs, ZZ.new(array.new<Pivot>()))
    // §3.2 corrected table. cOnXA/dOnXC carry Cypher's different leg basis.
    if useGartley
        array.push(defs, PatDef.new("Gartley",   "Gar", 0.618, 0.618, 0.382, 0.886, 0.786, 0.786, false, false))
    if useBat
        array.push(defs, PatDef.new("Bat",       "Bat", 0.382, 0.500, 0.382, 0.886, 0.886, 0.886, false, false))
    if useBfly
        array.push(defs, PatDef.new("Butterfly", "But", 0.786, 0.786, 0.382, 0.886, 1.270, 1.618, false, false))
    if useCrab
        array.push(defs, PatDef.new("Crab",      "Crb", 0.382, 0.618, 0.382, 0.886, 1.618, 1.618, false, false))
    if useDeep
        array.push(defs, PatDef.new("Deep Crab", "Dcr", 0.886, 0.886, 0.382, 0.886, 1.618, 1.618, false, false))
    if useCypher
        array.push(defs, PatDef.new("Cypher",    "Cyp", 0.382, 0.618, 1.272, 1.414, 0.786, 0.786, true,  true))
    if array.size(defs) > 0
        for i = 0 to array.size(defs) - 1
            array.push(cntFound, 0)

// ------------------------------------------------------- Multi-scale feed ---
// ta.pivothigh needs constant lengths, so the scales are unrolled rather than
// looped. Each scale keeps its own independent zig-zag.
newAt0 = false
newAt1 = false
newAt2 = false
newAt3 = false
newAt4 = false

ph0 = ta.pivothigh(3, 3),   pl0 = ta.pivotlow(3, 3)
ph1 = ta.pivothigh(5, 5),   pl1 = ta.pivotlow(5, 5)
ph2 = ta.pivothigh(8, 8),   pl2 = ta.pivotlow(8, 8)
ph3 = ta.pivothigh(13, 13), pl3 = ta.pivotlow(13, 13)
ph4 = ta.pivothigh(21, 21), pl4 = ta.pivotlow(21, 21)

if sc1 and array.size(zzs) > 0
    z = array.get(zzs, 0)
    if not na(ph0)
        newAt0 := pushPivot(z, ph0, bar_index - 3, true)
    if not na(pl0)
        newAt0 := pushPivot(z, pl0, bar_index - 3, false) or newAt0
if sc2 and array.size(zzs) > 1
    z = array.get(zzs, 1)
    if not na(ph1)
        newAt1 := pushPivot(z, ph1, bar_index - 5, true)
    if not na(pl1)
        newAt1 := pushPivot(z, pl1, bar_index - 5, false) or newAt1
if sc3 and array.size(zzs) > 2
    z = array.get(zzs, 2)
    if not na(ph2)
        newAt2 := pushPivot(z, ph2, bar_index - 8, true)
    if not na(pl2)
        newAt2 := pushPivot(z, pl2, bar_index - 8, false) or newAt2
if sc4 and array.size(zzs) > 3
    z = array.get(zzs, 3)
    if not na(ph3)
        newAt3 := pushPivot(z, ph3, bar_index - 13, true)
    if not na(pl3)
        newAt3 := pushPivot(z, pl3, bar_index - 13, false) or newAt3
if sc5 and array.size(zzs) > 4
    z = array.get(zzs, 4)
    if not na(ph4)
        newAt4 := pushPivot(z, ph4, bar_index - 21, true)
    if not na(pl4)
        newAt4 := pushPivot(z, pl4, bar_index - 21, false) or newAt4

// ---------------------------------------------------- Pattern completion ---
// A pattern completes when a NEW pivot arrives that can serve as D. Every
// scale is checked, and a dedup key stops the same structure being counted
// twice when two scales resolve it identically.
checkScale(ZZ z, bool isNew) =>
    if isNew and array.size(z.pts) >= 5 and array.size(defs) > 0
        n = array.size(z.pts)
        X = array.get(z.pts, n - 5)
        A = array.get(z.pts, n - 4)
        B = array.get(z.pts, n - 3)
        C = array.get(z.pts, n - 2)
        D = array.get(z.pts, n - 1)

        xa = A.price - X.price
        ab = A.price - B.price
        bc = C.price - B.price
        xc = C.price - X.price

        if xa != 0 and ab != 0 and bc != 0
            // XA rising (A above X) means D projects DOWN to a low you buy:
            // bullish. Verified against PRD §10.2 (BTC bullish Bat, xa = +18480)
            // and §10.1 (XAG bearish Butterfly, xa = -8.53).
            isBull = xa > 0
            dirOk = (isBull and useBull) or (not isBull and useBear)

            if dirOk
                bRat = ab / xa
                cRat = bc / ab
                cRatXA = xc / xa

                for i = 0 to array.size(defs) - 1
                    pd = array.get(defs, i)
                    cCheck = pd.cOnXA ? okRatio(cRatXA, pd.cLo, pd.cHi, pctErr) : okRatio(cRat, pd.cLo, pd.cHi, pctErr)

                    if bRat > 0 and okRatio(bRat, pd.bLo, pd.bHi, pctErr) and cCheck
                        // D's theoretical band, on XA or on XC per the pattern
                        // Cypher measures D on the XC leg; every other pattern on XA.
                        dRefFrom = pd.dOnXC ? C.price : A.price
                        dLoPx = dRefFrom + pd.dLo * (X.price - dRefFrom)
                        dHiPx = dRefFrom + pd.dHi * (X.price - dRefFrom)
                        dActual = D.price
                        dLegLen = math.abs(X.price - dRefFrom)
                        dBandLo = math.min(dLoPx, dHiPx)
                        dBandHi = math.max(dLoPx, dHiPx)
                        dTolPx = dLegLen * (pctErr / 100)

                        if dActual >= dBandLo - dTolPx and dActual <= dBandHi + dTolPx
                            key = pd.sym + (isBull ? "L" : "S") + str.tostring(X.idx) + "_" + str.tostring(A.idx) + "_" + str.tostring(B.idx) + "_" + str.tostring(C.idx) + "_" + str.tostring(D.idx)
                            if not array.includes(seen, key)
                                array.push(seen, key)
                                if array.size(seen) > 600
                                    array.shift(seen)

                                // Score: leg accuracy, PRZ tightness, D's closeness to the band
                                accB = fitScore(bRat, pd.bLo, pd.bHi, pctErr)
                                accC = fitScore(pd.cOnXA ? cRatXA : cRat, pd.cLo, pd.cHi, pctErr)
                                dMid = (dBandLo + dBandHi) / 2
                                dClose = dLegLen > 0 ? math.max(0.0, 1.0 - math.abs(dActual - dMid) / (dTolPx + (dBandHi - dBandLo) / 2 + syminfo.mintick)) : 0.0
                                przTight = dLegLen > 0 ? math.max(0.0, 1.0 - (dBandHi - dBandLo) / dLegLen) : 0.0
                                score = ((accB + accC) / 2 * 4 + przTight * 2 + dClose * 3) / 9 * 100

                                if score >= minScore
                                    array.set(cntFound, i, array.get(cntFound, i) + 1)
                                    entry = close
                                    adLeg = A.price - entry
                                    dirS = isBull ? 1.0 : -1.0

                                    t1 = switch t1Mode
                                        "0.382 AD" => entry + 0.382 * adLeg
                                        "0.5 AD"   => entry + 0.500 * adLeg
                                        "Point C"  => C.price
                                        "Point A"  => A.price
                                        => entry + 0.618 * adLeg

                                    t2 = switch t2Mode
                                        "0.618 AD"          => entry + 0.618 * adLeg
                                        "1.0 AD (Point A)"  => A.price
                                        "1.618 AD"          => entry + 1.618 * adLeg
                                        "None"              => na
                                        => entry + 1.272 * adLeg

                                    // Target-derived stop: R:R is fixed by construction
                                    // rather than left to a fixed ratio that may make the
                                    // target unreachable (PRD §7.3.1).
                                    ext = isBull ? math.min(X.price, D.price) : math.max(X.price, D.price)
                                    stop = stopMode == "% of distance to Target 1" ? entry - dirS * math.abs(t1 - entry) * (stopPct / 100) : ext - dirS * math.abs(entry - ext) * (stopPct / 100)

                                    if math.abs(entry - stop) > 0 and ((isBull and t1 > entry) or (not isBull and t1 < entry))
                                        patLen = math.max(10, D.idx - X.idx)
                                        s = Sig.new(i, isBull, entry, stop, t1, na(t2) ? t1 : t2, bar_index, bar_index + int(patLen * tLimitMult), 0, false, score, na)
                                        array.push(sigs, s)

                                        col = isBull ? cBull : cBear
                                        if array.size(sigs) <= maxDraw or array.size(sigs) > 0
                                            if showPoly
                                                pts = array.new<chart.point>()
                                                array.push(pts, chart.point.from_index(X.idx, X.price))
                                                array.push(pts, chart.point.from_index(A.idx, A.price))
                                                array.push(pts, chart.point.from_index(B.idx, B.price))
                                                array.push(pts, chart.point.from_index(C.idx, C.price))
                                                array.push(pts, chart.point.from_index(D.idx, D.price))
                                                polyline.new(pts, closed = true, xloc = xloc.bar_index, line_color = color.new(col, 25), fill_color = color.new(col, 90), line_width = 1)
                                            if showLevels
                                                line.new(D.idx, s.t1,   D.idx + 20, s.t1,   xloc = xloc.bar_index, color = color.new(#26A69A, 30), style = line.style_dashed)
                                                line.new(D.idx, s.t2,   D.idx + 20, s.t2,   xloc = xloc.bar_index, color = color.new(#26A69A, 55), style = line.style_dotted)
                                                line.new(D.idx, s.stop, D.idx + 20, s.stop, xloc = xloc.bar_index, color = color.new(#EF5350, 30), style = line.style_dashed)
                                            if showLabels
                                                tt = pd.name + (isBull ? "  ▲ LONG" : "  ▼ SHORT") + "\nScore " + str.tostring(score, "#.#") + "\n\nAB/XA " + str.tostring(bRat, "0.000") + "  (" + str.tostring(pd.bLo, "0.000") + (pd.bLo == pd.bHi ? "" : "-" + str.tostring(pd.bHi, "0.000")) + ")\n" + (pd.cOnXA ? "XC/XA " : "BC/AB ") + str.tostring(pd.cOnXA ? cRatXA : cRat, "0.000") + "  (" + str.tostring(pd.cLo, "0.000") + "-" + str.tostring(pd.cHi, "0.000") + ")\n\nEntry " + str.tostring(entry, format.mintick) + "\nStop  " + str.tostring(stop, format.mintick) + "\nT1    " + str.tostring(s.t1, format.mintick) + "\nT2    " + str.tostring(s.t2, format.mintick) + "\nR:R   " + str.tostring(math.abs(s.t2 - entry) / math.abs(entry - stop), "#.##")
                                                s.lbl := label.new(D.idx, D.price, pd.sym + " " + str.tostring(score, "#") + " ⏳", xloc = xloc.bar_index, style = isBull ? label.style_label_up : label.style_label_down, color = color.new(col, 20), textcolor = color.white, size = size.small, tooltip = tt)

if array.size(zzs) > 4
    checkScale(array.get(zzs, 0), newAt0)
    checkScale(array.get(zzs, 1), newAt1)
    checkScale(array.get(zzs, 2), newAt2)
    checkScale(array.get(zzs, 3), newAt3)
    checkScale(array.get(zzs, 4), newAt4)

// ------------------------------------------------------- Outcome tracking ---
// Every pattern runs to its own outcome — no position limit, unlike the
// strategy() edition. Stop is checked before targets, so a bar spanning both
// resolves as a loss.
if array.size(sigs) > 0
    for j = 0 to array.size(sigs) - 1
        s = array.get(sigs, j)
        if s.status == 0
            hitStop = s.isBull ? low <= s.stop : high >= s.stop
            hitT1   = s.isBull ? high >= s.t1  : low  <= s.t1
            hitT2   = s.isBull ? high >= s.t2  : low  <= s.t2
            if hitT1
                s.t1Hit := true
            if hitStop
                s.status := s.t1Hit ? 2 : 3
            else if hitT2 and s.t1Hit
                s.status := 1
            else if bar_index >= s.expireBar
                s.status := 4
            if s.status != 0 and not na(s.lbl)
                mark = s.status == 1 ? " ✅✅" : s.status == 2 ? " ✅" : s.status == 3 ? " ❌" : " 🕝"
                label.set_text(s.lbl, str.replace(label.get_text(s.lbl), " ⏳", mark))

// ------------------------------------------------------------ Statistics ---
// Return per closed pattern: 50% out at T1, 50% at T2, or at the stop if that
// comes first. Open and timed-out patterns are excluded entirely.
retPct(Sig s) =>
    d = s.isBull ? 1.0 : -1.0
    r = s.status == 1 ? (d * (s.t1 - s.entry) / s.entry * 0.5 + d * (s.t2 - s.entry) / s.entry * 0.5) : s.status == 2 ? (d * (s.t1 - s.entry) / s.entry * 0.5 + d * (s.stop - s.entry) / s.entry * 0.5) : s.status == 3 ? d * (s.stop - s.entry) / s.entry : 0.0
    r * 100

if showTable and barstate.islast and array.size(defs) > 0
    pos = tblPos == "Bottom left" ? position.bottom_left : tblPos == "Bottom right" ? position.bottom_right : tblPos == "Top left" ? position.top_left : position.top_right
    var table tb = table.new(pos, 7, array.size(defs) + 3, bgcolor = color.new(#131722, 15), border_width = 1, border_color = color.new(color.gray, 60))
    hb = color.new(#2A2E39, 0)
    table.cell(tb, 0, 0, " ",              text_color = color.white, bgcolor = hb, text_size = size.small)
    table.cell(tb, 1, 0, "Patterns",       text_color = color.white, bgcolor = hb, text_size = size.small)
    table.cell(tb, 2, 0, "Trades",         text_color = color.white, bgcolor = hb, text_size = size.small)
    table.cell(tb, 3, 0, "T1 Success",     text_color = color.white, bgcolor = hb, text_size = size.small)
    table.cell(tb, 4, 0, "T2 Success",     text_color = color.white, bgcolor = hb, text_size = size.small)
    table.cell(tb, 5, 0, "Avg Return %",   text_color = color.white, bgcolor = hb, text_size = size.small)
    table.cell(tb, 6, 0, "Total Return %", text_color = color.white, bgcolor = hb, text_size = size.small)

    gFound = 0
    gClosed = 0
    gT1 = 0
    gT2 = 0
    gRet = 0.0
    for i = 0 to array.size(defs) - 1
        pd = array.get(defs, i)
        closed = 0
        n1 = 0
        n2 = 0
        rsum = 0.0
        if array.size(sigs) > 0
            for j = 0 to array.size(sigs) - 1
                s = array.get(sigs, j)
                if s.patIdx == i and (s.status == 1 or s.status == 2 or s.status == 3)
                    closed += 1
                    rsum += retPct(s)
                    if s.t1Hit
                        n1 += 1
                    if s.status == 1
                        n2 += 1
        found = array.get(cntFound, i)
        gFound += found
        gClosed += closed
        gT1 += n1
        gT2 += n2
        gRet += rsum
        rc = rsum > 0 ? #26A69A : rsum < 0 ? #EF5350 : color.gray
        table.cell(tb, 0, i + 1, "  " + pd.sym + "  ", text_color = color.white, text_size = size.small)
        table.cell(tb, 1, i + 1, str.tostring(found),  text_color = color.white, text_size = size.small)
        table.cell(tb, 2, i + 1, str.tostring(closed), text_color = color.white, text_size = size.small)
        table.cell(tb, 3, i + 1, closed > 0 ? str.tostring(float(n1) / closed * 100, "#.##") + "%" : "NA", text_color = color.white, text_size = size.small)
        table.cell(tb, 4, i + 1, closed > 0 ? str.tostring(float(n2) / closed * 100, "#.##") + "%" : "NA", text_color = color.white, text_size = size.small)
        table.cell(tb, 5, i + 1, closed > 0 ? str.tostring(rsum / closed, "#.##") + "%" : "NA", text_color = rc, text_size = size.small)
        table.cell(tb, 6, i + 1, closed > 0 ? str.tostring(rsum, "#.##") + "%" : "NA",          text_color = rc, text_size = size.small)

    lr = array.size(defs) + 1
    gc = gRet > 0 ? #26A69A : gRet < 0 ? #EF5350 : color.gray
    table.cell(tb, 0, lr, "Total",                text_color = color.white, bgcolor = hb, text_size = size.small)
    table.cell(tb, 1, lr, str.tostring(gFound),   text_color = color.white, bgcolor = hb, text_size = size.small)
    table.cell(tb, 2, lr, str.tostring(gClosed),  text_color = color.white, bgcolor = hb, text_size = size.small)
    table.cell(tb, 3, lr, gClosed > 0 ? str.tostring(float(gT1) / gClosed * 100, "#.##") + "%" : "NA", text_color = color.white, bgcolor = hb, text_size = size.small)
    table.cell(tb, 4, lr, gClosed > 0 ? str.tostring(float(gT2) / gClosed * 100, "#.##") + "%" : "NA", text_color = color.white, bgcolor = hb, text_size = size.small)
    table.cell(tb, 5, lr, gClosed > 0 ? str.tostring(gRet / gClosed, "#.##") + "%" : "NA", text_color = gc, bgcolor = hb, text_size = size.small)
    table.cell(tb, 6, lr, gClosed > 0 ? str.tostring(gRet, "#.##") + "%" : "NA",          text_color = gc, bgcolor = hb, text_size = size.small)

    kr = array.size(defs) + 2
    table.cell(tb, 0, kr, "✅✅ = T1+T2  |  ✅ = T1 only  |  ❌ = Stopped  |  🕝 = Timed out*  |  ⏳ = In progress*\n*Not included in Success Rate / Return % statistics", text_color = color.new(color.white, 25), text_size = size.tiny)
    table.merge_cells(tb, 0, kr, 6, kr)
